#' Scatter plot
#'
#' Scatter plot from AESN
#'
scatter_plot <- function(
x,
y,
xlab = "",
ylab = "",
main = NULL,
add_line = FALSE
) {
old_par <- par(no.readonly = TRUE)
on.exit(par(old_par))
par(
family = "serif",
mar = c(5, 5, 4, 2),
las = 1,
bty = "n"
)
x_range <- range(x, na.rm = TRUE)
y_range <- range(y, na.rm = TRUE)
x_pad <- diff(x_range) * 0.06
y_pad <- diff(y_range) * 0.06
plot(
x,
y,
type = "n",
xlim = x_range + c(-x_pad, x_pad),
ylim = y_range + c(-y_pad, y_pad),
xaxt = "n",
yaxt = "n",
xlab = "",
ylab = "",
main = ""
)
# Muted retro grid
abline(
h = pretty(y),
v = pretty(x),
col = "#D8CFC4",
lty = 1
)
# Points
points(
x,
y,
pch = 21,
bg = "#C77C5D",
col = "#3D3A35",
cex = 1.3
)
# Axes
axis(
1,
col = "#3D3A35",
col.axis = "#3D3A35",
lwd = 0,
lwd.ticks = 1
)
axis(
2,
col = "#3D3A35",
col.axis = "#3D3A35",
lwd = 0,
lwd.ticks = 1
)
# Labels
mtext(
xlab,
side = 1,
line = 3,
family = "serif",
col = "#3D3A35"
)
mtext(
ylab,
side = 2,
line = 3,
family = "serif",
col = "#3D3A35"
)
# Centered title
if (!is.null(main)) {
title(
main = toupper(main),
family = "serif",
font.main = 2,
cex.main = 1.3,
col.main = "#3D3A35",
line = 1
)
}
# Regression line
if (add_line) {
abline(
lm(y ~ x),
col = "#4E6B50",
lwd = 2.5
)
}
invisible(NULL)
}
