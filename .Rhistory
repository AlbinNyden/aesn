abline(
model,
col = "#111827",
lwd = 2
)
}
invisible(NULL)
}
scatter_plot(x = c(1,2,3), y = c(3,4,5))
#' Scatter plot
#'
#' Scatter plot from AESN
#'
scatter_plot <- function(
x,
y,
xlab = NULL,
ylab = NULL,
main = NULL,
add_line = FALSE,
line = "lm",
pch = 19,
point_size = 1.2,
point_alpha = 0.6,
grid = TRUE
) {
# Save current graphical parameters
old_par <- par(no.readonly = TRUE)
on.exit(par(old_par))
# Convert alpha to hexadecimal
alpha <- max(0, min(1, point_alpha))
alpha_hex <- sprintf("%02X", round(alpha * 255))
# Point colour
point_col <- paste0("#2563EB", alpha_hex)
# Margins
par(
mar = c(4.5, 4.5, 2.5, 1),
las = 1,
bty = "n"
)
# Determine limits
x_range <- range(x, na.rm = TRUE)
y_range <- range(y, na.rm = TRUE)
x_padding <- diff(x_range) * 0.05
y_padding <- diff(y_range) * 0.05
if (x_padding == 0) x_padding <- 1
if (y_padding == 0) y_padding <- 1
xlim <- x_range + c(-x_padding, x_padding)
ylim <- y_range + c(-y_padding, y_padding)
# Empty plot
plot(
x,
y,
type = "n",
xlim = xlim,
ylim = ylim,
xaxt = "n",
yaxt = "n",
xlab = "",
ylab = "",
main = ""
)
# Grid
if (grid) {
abline(
h = pretty(y_range),
v = pretty(x_range),
col = "#E5E",
lty = 1,
lwd = 1
)
}
# Points
points(
x,
y,
pch = pch,
cex = point_size,
col = point_col
)
# Axes
axis(
1,
col = "#9CA3AF",
col.axis = "#374151",
lwd = 0,
lwd.ticks = 1
)
axis(
2,
col = "#9CA3AF",
col.axis = "#374151",
lwd = 0,
lwd.ticks = 1
)
# Axis labels
mtext(
xlab,
side = 1,
line = 2.8,
col = "#374151",
cex = 0.95
)
mtext(
ylab,
side = 2,
line = 2.8,
col = "#374151",
cex = 0.95
)
# Title
if (!is.null(main)) {
title(
main = main,
adj = 0,
line = 0.5,
col.main = "#111827",
font.main = 2,
cex.main = 1.2
)
}
# Regression line
if (add_line) {
model <- lm(y ~ x)
abline(
model,
col = "#111827",
lwd = 2
)
}
invisible(NULL)
}
scatter_plot(x = c(1,2,3), y = c(3,4,5))
